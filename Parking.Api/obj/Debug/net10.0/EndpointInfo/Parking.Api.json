    "/api/parking/check-out": {
      "post": {
        "tags": [
          "Parking"
        ],
        "parameters": [
          {
            "name": "vehicleId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
