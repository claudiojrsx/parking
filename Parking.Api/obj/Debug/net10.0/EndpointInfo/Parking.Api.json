  "components": {
    "schemas": {
      "CheckInRequest": {
        "type": "object",
        "properties": {
          "plate": {
            "type": "string",
            "nullable": true
          },
          "vehicleType": {
            "$ref": "#/components/schemas/VehicleType"
          }
        },
        "additionalProperties": false
      },
      "CreateParkingSpotRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "$ref": "#/components/schemas/ParkingSpotType"
          }
        },
        "additionalProperties": false
      },
      "CreatePricingRequest": {
        "type": "object",
        "properties": {
          "motorcycle": {
            "type": "number",
            "format": "double"
          },
          "car": {
            "type": "number",
            "format": "double"
          },
          "truck": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ParkingSpotType": {
        "enum": [
          "Motorcycle",
          "Car",
          "Truck"
        ],
        "type": "string"
      },
      "PricingResponse": {
        "type": "object",
        "properties": {
          "motorcycle": {
            "type": "number",
            "format": "double"
          },
          "car": {
            "type": "number",
            "format": "double"
          },
          "truck": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "VehicleType": {
        "enum": [
          "Motorcycle",
          "Car",
          "Truck"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Digite: Bearer {seu token JWT}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}