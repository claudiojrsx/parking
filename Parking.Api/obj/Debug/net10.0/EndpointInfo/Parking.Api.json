        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
